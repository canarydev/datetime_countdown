<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="datetime_countdown_widget.DatetimeCountdownField" owl="1">
        <div class="o_datetime_countdown">
            <t t-if="!hasDeadline">
                <span class="badge rounded-pill text-bg-secondary">No limit</span>
            </t>
            <t t-elif="expired">
                <span class="badge rounded-pill text-bg-danger">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Finished
                </span>
            </t>
            <t t-elif="under24h">
                <span class="badge rounded-pill text-bg-warning">
                    <i class="fa fa-hourglass-half me-1"/>
                    <t t-esc="countdownText"/>
                </span>
            </t>
            <t t-else="">
                <span class="badge rounded-pill text-bg-info">
                    <i class="fa fa-calendar me-1"/>
                    <t t-esc="daysText"/>
                </span>
            </t>
            <t t-if="hasDeadline">
                <div class="o_datetime_countdown_deadline">
                    <t t-esc="deadlineLabel"/>
                </div>
            </t>
        </div>
    </t>
</templates>
